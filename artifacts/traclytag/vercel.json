{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/uploads/:path*",
      "destination": "https://tracly-tag-api-server.vercel.app/api/uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tracly-tag-api-server.vercel.app/api/:path*"
    },
    {
      "source": "/((?!assets|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}