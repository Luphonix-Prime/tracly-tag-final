# ==============================================================================
# TraclyTag Single Sign-On (SSO) Environment Variables
# ==============================================================================

# Session signing key
SESSION_SECRET=your-secure-session-signing-secret-here

# Base URL or callback URL for local development (defaults to http://localhost:5173)
# SSO_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here

# GitHub OAuth App Credentials
# Get these from GitHub Profile Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here
